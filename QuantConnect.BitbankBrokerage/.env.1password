# 1Password secret references for `op run` — safe to commit (no real values).
# Adjust the vault (Private) and item (bitbank-api-test) names to your setup;
# see SETUP.md §2 for creating the item.
# Usage (from the Lean repo root):
#   op run --env-file=QuantConnect.BitbankBrokerage/.env.1password -- <command>
BITBANK_API_KEY="op://Private/bitbank-api-test/api-key"
BITBANK_API_SECRET="op://Private/bitbank-api-test/api-secret"
